# --- 1. Network & Wallet ---
# Read-only scans may use WALLET_ADDRESS alone. Live execution derives it from PRIVATE_KEY.
CHAIN_ID=100
WALLET_ADDRESS=
PRIVATE_KEY=
RPC_URL=https://rpc.gnosischain.com
WSS_URL=wss://rpc.gnosischain.com/wss

# --- 2. Execution Safety Flags ---
# Both false            -> DRY-RUN: logs what it would trade, signs nothing.
# EXECUTE_TRADES=true   -> SIMULATE-ONLY: needs PRIVATE_KEY; eth_call simulation of the buy leg, nothing sent.
# Both true             -> LIVE: sends the two swaps (needs PRIVATE_KEY, wxDAI and a little xDAI for gas).
# ALLOW_UNPROFITABLE_SMOKE_TEST=true also executes non-profitable routes (loses fees) - plumbing test only.
EXECUTE_TRADES=false
ENABLE_MAINNET_TRADING=false
ALLOW_UNPROFITABLE_SMOKE_TEST=false

# --- 3. Sizing & Profit Thresholds (Quoted in wxDAI) ---
# DEX pools trade ERC-20 wxDAI, while gas is paid in native xDAI.
TRADE_SIZES_WXDAI=10,25,50,100
MAX_TRADES_PER_RUN=2
MAX_TOTAL_WXDAI_PER_RUN=200
GAS_COST_XDAI=0.001
MAX_GAS_PRICE_GWEI=10
MIN_NET_PROFIT_WXDAI=0.01
MAX_SLIPPAGE_BPS=50

# --- 4. Scanner Timing & Lifecycle ---
# "block" uses WSS_URL newHeads (5s blocks); "interval" uses HTTP polling.
SCAN_TRIGGER_MODE=block
SCAN_INTERVAL_MS=5000
MAX_SOURCE_LATENCY_MS=5000
MAX_RUNTIME_MINUTES=720

# --- 5. Core Token Contracts (Gnosis Mainnet) ---
WXDAI_TOKEN_ADDRESS=0xe91D153E0b41518A2Ce8Dd3D7944Fa863463a97d
GNO_TOKEN_ADDRESS=0x9C58BAcC331c9aa871AFD802DB6379a98e80CEdb
